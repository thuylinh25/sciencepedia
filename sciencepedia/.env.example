# ---------- Supabase: PostgreSQL ----------
# Lấy tại Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  : "Transaction pooler" (cổng 6543) — dùng lúc chạy ứng dụng.
#                 Bắt buộc có ?pgbouncer=true.
#                 connection_limit: để 10 cho dev và cho `next build` — build
#                 prerender nhiều trang song song, để 1 sẽ dính lỗi P2024
#                 "Timed out fetching a new connection". Hạ về 1 khi chạy
#                 serverless, vì ở đó mỗi instance là một tiến trình riêng.
# DIRECT_URL    : "Direct connection" (cổng 5432) — chỉ dùng cho prisma migrate.
#
# LƯU Ý: mật khẩu phải percent-encode. Ví dụ `!Abc@123` -> `!Abc%40123`;
#        để nguyên dấu @ thì connection string bị cắt sai chỗ.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- Supabase: Storage (ảnh) ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Service role key CHỈ dùng ở server (upload/xoá ảnh). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Tên bucket công khai chứa ảnh bài viết
SUPABASE_STORAGE_BUCKET="article-images"

# ---------- NextAuth (Auth.js v5) ----------
# openssl rand -base64 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth (tuỳ chọn — bỏ trống thì chỉ đăng nhập bằng email/mật khẩu)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Meilisearch ----------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKey-doi-trong-production"
# Khoá chỉ-đọc dùng ở client (tuỳ chọn, để trống sẽ search qua API route)
NEXT_PUBLIC_MEILISEARCH_HOST=""
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=""

# ---------- AI Assistant ----------
# Chính: Google Gemini — lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# `gemini-2.5-flash` đã ngừng mở cho user mới (API trả 404 kèm gợi ý đổi model).
# Xem danh sách khả dụng với key của bạn:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL="gemini-3.6-flash"

# Dự phòng: OpenRouter — dùng khi Gemini hết quota (429), quá tải (503) hoặc
# model không còn khả dụng (404). Bỏ trống thì không có dự phòng.
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Thử lần lượt từ trái sang phải. Các model `:free` dùng pool chia sẻ nên bị
# 429 khá thường xuyên — đó là lý do nên khai báo nhiều hơn một model.
# Tránh model rò rỉ chain-of-thought vào câu trả lời (ví dụ nemotron-3.5-lightning).
OPENROUTER_MODELS="z-ai/glm-5.2:free,minimax/minimax-m3:free,google/gemma-4-31b-it:free"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Sciencepedia"

# ---------- Seed ----------
SEED_ADMIN_EMAIL="admin@sciencepedia.dev"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---------- Đồng bộ nguồn hằng ngày ----------
# Bí mật bảo vệ /api/cron/sync-sources. Vercel Cron tự gửi header
# `Authorization: Bearer $CRON_SECRET` khi biến này được khai báo trong project.
# Bỏ trống thì route trả 503 và không chạy — cố ý, để endpoint không mở công khai.
# Sinh chuỗi ngẫu nhiên: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=""

# ---------- Claude biên tập bài tự động ----------
# Khoá API Anthropic, lấy tại https://console.anthropic.com/settings/keys
# Bỏ trống thì cron vẫn chạy nhưng bài rơi hết về bản nháp thay vì đăng.
ANTHROPIC_API_KEY=""
# Bỏ trống dùng claude-sonnet-5. Đổi sang claude-opus-5 nếu cần bài chất hơn
# (đắt và chậm hơn), hoặc claude-haiku-4-5-20251001 nếu cần rẻ và nhanh.
ANTHROPIC_MODEL=""
