{
  "name": "sciencepedia",
  "version": "1.0.0",
  "private": true,
  "description": "Sciencepedia — bách khoa toàn thư khoa học hiện đại (Next.js 15)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "images:credit": "tsx --env-file-if-exists=.env scripts/backfill-image-credit.ts",
    "graph:check": "tsx --env-file-if-exists=.env scripts/check-graph.ts",
    "publish:check": "tsx --env-file-if-exists=.env scripts/check-publish.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "search:reindex": "tsx --env-file-if-exists=.env scripts/reindex.ts",
    "storage:setup": "tsx --env-file-if-exists=.env scripts/setup-storage.ts",
    "import:notion": "tsx --env-file-if-exists=.env scripts/import-notion.ts",
    "postinstall": "prisma generate",
    "publish": "tsx --env-file-if-exists=.env scripts/publish.ts",
    "pipeline": "tsx --env-file-if-exists=.env scripts/pipeline.ts",
    "taxonomy:tier2": "tsx --env-file-if-exists=.env scripts/seed-taxonomy.ts",
    "category:image": "tsx --env-file-if-exists=.env scripts/set-category-image.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@anthropic-ai/sdk": "^0.123.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@google/genai": "^2.20.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.545.0",
    "meilisearch": "^0.54.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.3.12",
    "next-themes": "^0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "sharp": true,
    "esbuild": true,
    "unrs-resolver": true,
    "protobufjs": true,
    "@parcel/watcher": true,
    "@google/genai": true,
    "@swc/core": true
  },
  "overrides": {
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.2"
  }
}
