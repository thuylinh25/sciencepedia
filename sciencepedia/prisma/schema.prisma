generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String        @id @default(cuid())
  name             String?
  email            String        @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  bio              String?
  role             Role          @default(USER)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accounts         Account[]
  articles         Article[]     @relation("ArticleAuthor")
  reviewedArticles Article[]     @relation("ArticleReviewer")
  bookmarks        Bookmark[]
  chats            ChatSession[]
  comments         Comment[]
  media            Media[]
  sessions         Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Danh mục khoa học — hỗ trợ lồng nhau (Vũ trụ > Hệ Mặt Trời > Sao Hoả)
model Category {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  nameEn             String
  description        String?
  descriptionEn      String?
  /// Tên icon lucide-react, ví dụ "Telescope"
  icon               String?
  /// Màu chủ đạo dạng hex, dùng cho gradient card
  color              String     @default("#3b82f6")
  coverImage         String?
  order              Int        @default(0)
  parentId           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  /// Ghi công ảnh bìa: tác giả, nguồn, giấy phép. BẮT BUỘC khi ảnh dùng giấy
  /// phép đòi ghi công (CC BY, CC BY-SA). Markdown, để nhét được link tới
  /// trang gốc trên Wikimedia. Ảnh thuộc phạm vi công cộng thì không bắt buộc
  /// nhưng vẫn nên ghi.
  coverImageCredit   String?
  coverImageCreditEn String?
  articles           Article[]
  parent             Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[] @relation("CategoryTree")

  @@index([parentId])
  @@index([order])
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  nameEn    String
  color     String       @default("#64748b")
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model Article {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  title              String
  titleEn            String?
  summary            String
  summaryEn          String?
  content            String
  contentEn          String?
  coverImage         String?
  /// Ảnh dùng riêng cho og:image nếu khác cover
  ogImage            String?
  status             ArticleStatus            @default(DRAFT)
  featured           Boolean                  @default(false)
  readingTime        Int                      @default(1)
  views              Int                      @default(0)
  /// Từ khoá SEO, phân tách bằng dấu phẩy
  seoKeywords        String?
  seoTitle           String?
  seoDescription     String?
  publishedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  authorId           String
  categoryId         String
  /// Cột tsvector do Postgres tự sinh (GENERATED ALWAYS ... STORED), phục vụ
  /// full-text search dự phòng khi không có Meilisearch. Prisma không hỗ trợ
  /// generated column nên khai báo Unsupported: nó không xuất hiện trong Prisma
  /// Client và chỉ được truy vấn bằng raw SQL ở src/lib/search-postgres.ts.
  /// Biểu thức sinh cột nằm trong migration 20260901120000_article_search_vector.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("((((((setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(title, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(\"titleEn\", ''::text))), 'A'::\"char\")) || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(summary, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(\"summaryEn\", ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(\"seoKeywords\", ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(content, ''::text))), 'D'::\"char\")) || setweight(to_tsvector('simple'::regconfig, sciencepedia_unaccent(COALESCE(\"contentEn\", ''::text))), 'D'::\"char\"))"))
  /// Kết quả bước fact-check (bước 2 và bước 4 của pipeline)
  factCheck          FactCheckState           @default(PENDING)
  /// Biên tập viên khoa học đã duyệt — hiển thị byline trên trang
  reviewedById       String?
  reviewedAt         DateTime?
  /// Lần gần nhất đối chiếu lại claim với nguồn. Nội dung khoa học hết hạn:
  /// số liệu được đo lại, bài báo bị rút, đồng thuận thay đổi.
  lastVerifiedAt     DateTime?
  /// Hạn đối chiếu lại tiếp theo, do science-editor đặt theo mức độ biến động
  reverifyDueAt      DateTime?
  /// Khái niệm mà bài này trình bày. Nguồn của related concepts, prerequisite
  /// và internal link — thay cho cách suy ra từ tag/category.
  entityId           String?
  /// Ghi công ảnh bìa: tác giả, nguồn, giấy phép. BẮT BUỘC khi ảnh dùng giấy
  /// phép đòi ghi công (CC BY, CC BY-SA). Markdown, để nhét được link tới
  /// trang gốc trên Wikimedia. Ảnh thuộc phạm vi công cộng thì không bắt buộc
  /// nhưng vẫn nên ghi.
  coverImageCredit   String?
  coverImageCreditEn String?
  author             User                     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category           Category                 @relation(fields: [categoryId], references: [id])
  entity             Entity?                  @relation(fields: [entityId], references: [id])
  reviewedBy         User?                    @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  tags               ArticleTag[]
  bookmarks          Bookmark[]
  comments           Comment[]
  revisions          Revision[]
  sources            Source[]

  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
  @@index([entityId])
  @@index([reverifyDueAt])
  @@index([reviewedById])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Nguồn tham khảo — bách khoa toàn thư phải trích dẫn được
model Source {
  id          String    @id @default(cuid())
  articleId   String
  title       String
  url         String?
  publisher   String?
  year        Int?
  /// Bậc nguồn theo phân cấp của science-editor (1 = mạnh nhất).
  /// 1 bình duyệt · 2 cơ quan thẩm quyền · 3 giáo dục · 4 báo chí khoa học.
  /// Bài viết cần tối thiểu 3 nguồn độc lập bậc 1–2.
  tier        Int       @default(2)
  doi         String?
  /// Ngày truy cập URL — nguồn web thay đổi, cần biết đã đọc bản nào
  accessedAt  DateTime?
  /// Khác null nghĩa là bài báo đã bị rút: mọi claim dựa vào nó không còn giá trị
  retractedAt DateTime?
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// Lịch sử phiên bản của bài viết
model Revision {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String
  note      String?
  editorId  String?
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  approved  Boolean   @default(true)
  createdAt DateTime  @default(now())
  articleId String
  userId    String
  parentId  String?
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

/// Ảnh đã tải lên Supabase Storage.
/// Lưu lại `path` để còn xoá được file khi cần — chỉ có publicUrl thì không đủ,
/// và để biết ảnh nào đang mồ côi (không bài viết nào dùng).
model Media {
  id           String   @id @default(cuid())
  /// Đường dẫn trong bucket, ví dụ "articles/2026/09/abc123.webp"
  path         String   @unique
  bucket       String
  url          String
  mimeType     String
  /// Byte
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime @default(now())
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById, createdAt])
}

/// Bộ đếm rate limit dùng chung giữa các instance serverless.
/// Xem chú thích trong src/lib/rate-limit.ts để biết vì sao không đếm trong RAM.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  title     String        @default("Cuộc trò chuyện mới")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  /// JSON: danh sách slug bài viết được trích dẫn
  citations String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// Một khái niệm khoa học — độc lập với ngôn ngữ và độc lập với bài viết.
/// Một entity có tối đa một bài viết mỗi locale; bài viết là cách trình bày
/// entity, không phải bản thân entity.
model Entity {
  id              String         @id @default(cuid())
  slug            String         @unique
  canonicalName   String
  canonicalNameEn String
  entityType      EntityType
  /// Tên gọi khác + cách viết sai phổ biến, dùng cho tìm kiếm và khử trùng lặp
  aliases         String[]       @default([])
  /// Định danh Wikidata, ví dụ "Q11982" — để đối chiếu với nguồn thẩm quyền
  wikidataQid     String?
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  articles        Article[]
  outgoingEdges   Relationship[] @relation("EdgeFrom")
  incomingEdges   Relationship[] @relation("EdgeTo")

  @@index([entityType])
  @@index([wikidataQid])
}

model Relationship {
  id           String       @id @default(cuid())
  fromEntityId String
  toEntityId   String
  relType      RelationType
  /// Độ mạnh 0–1, dùng để xếp thứ tự related concepts
  weight       Float        @default(1)
  note         String?
  createdAt    DateTime     @default(now())
  fromEntity   Entity       @relation("EdgeFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     Entity       @relation("EdgeTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relType])
  @@index([toEntityId, relType])
  @@index([relType])
}

enum Role {
  USER
  EDITOR
  ADMIN
}

/// Trạng thái thẩm định của bài viết trong pipeline 11 bước.
enum FactCheckState {
  PENDING
  PASSED
  REVISE
  FAILED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum EntityType {
  CONCEPT
  PHENOMENON
  ORGANISM
  SUBSTANCE
  OBJECT
  PROCESS
  THEORY
  LAW
  METHOD
  PERSON
  EVENT
  MISSION
  DATASET
  QUANTITY
}

/// Quan hệ có kiểu và có hướng. Cấm quan hệ "related" chung chung:
/// link chỉ có nghĩa khi biết nó nghĩa là gì.
enum RelationType {
  IS_A
  PART_OF
  PREREQUISITE_OF
  CAUSES
  MEASURED_BY
  DISCOVERED_BY
  APPLIES_TO
  CONTRASTS_WITH
  EXAMPLE_OF
}
