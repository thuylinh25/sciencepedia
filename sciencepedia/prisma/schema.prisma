// Sciencepedia — Prisma schema
// Supabase PostgreSQL + NextAuth (Auth.js v5) + nội dung song ngữ vi/en

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime đi qua Supavisor (connection pooler, cổng 6543).
  // Serverless mở/đóng kết nối liên tục nên bắt buộc phải qua pooler,
  // nếu nối thẳng cổng 5432 sẽ nhanh chóng cạn slot kết nối của Postgres.
  url = env("DATABASE_URL")

  // Migration cần kết nối trực tiếp (cổng 5432): pooler ở chế độ transaction
  // không hỗ trợ prepared statement và câu lệnh DDL mà Prisma Migrate dùng.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- Auth.js

enum Role {
  USER
  EDITOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  articles         Article[]     @relation("ArticleAuthor")
  reviewedArticles Article[]     @relation("ArticleReviewer")
  comments         Comment[]
  bookmarks        Bookmark[]
  chats            ChatSession[]
  media            Media[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- Nội dung

/// Trạng thái thẩm định của bài viết trong pipeline 11 bước.
enum FactCheckState {
  PENDING // chưa chạy fact-check
  PASSED // nguồn và claim đã đối chiếu xong
  REVISE // có phát hiện S2/S3, cần sửa
  FAILED // có phát hiện S1 (bịa nguồn / gán sai) — không được publish
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Danh mục khoa học — hỗ trợ lồng nhau (Vũ trụ > Hệ Mặt Trời > Sao Hoả)
model Category {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String // tiếng Việt
  nameEn        String
  description   String? @db.Text
  descriptionEn String? @db.Text
  /// Tên icon lucide-react, ví dụ "Telescope"
  icon          String?
  /// Màu chủ đạo dạng hex, dùng cho gradient card
  color         String  @default("#3b82f6")
  coverImage    String?
  order         Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([order])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameEn    String
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  articles ArticleTag[]
}

model Article {
  id   String @id @default(cuid())
  slug String @unique

  // Song ngữ — trường *En là bản tiếng Anh
  title     String
  titleEn   String?
  summary   String  @db.Text
  summaryEn String? @db.Text
  content   String  @db.Text // Markdown
  contentEn String? @db.Text

  coverImage String?
  /// Ảnh dùng riêng cho og:image nếu khác cover
  ogImage    String?

  status      ArticleStatus @default(DRAFT)
  featured    Boolean       @default(false)
  readingTime Int           @default(1) // phút
  views       Int           @default(0)

  /// Từ khoá SEO, phân tách bằng dấu phẩy
  seoKeywords    String?
  seoTitle       String?
  seoDescription String? @db.Text

  /// Cột tsvector do Postgres tự sinh (GENERATED ALWAYS ... STORED), phục vụ
  /// full-text search dự phòng khi không có Meilisearch. Prisma không hỗ trợ
  /// generated column nên khai báo Unsupported: nó không xuất hiện trong Prisma
  /// Client và chỉ được truy vấn bằng raw SQL ở src/lib/search-postgres.ts.
  /// Biểu thức sinh cột nằm trong migration 20260901120000_article_search_vector.
  searchVector Unsupported("tsvector")?

  // -------- Truy xuất nguồn gốc biên tập (science-editor gate)
  // Mọi bài đã publish phải hiển thị được: ai duyệt, duyệt khi nào, và lần
  // cuối đối chiếu lại với nguồn là bao giờ. Không có ba thứ này thì không
  // chứng minh được độ tin cậy — đây là tín hiệu E-E-A-T bắt buộc.

  /// Kết quả bước fact-check (bước 2 và bước 4 của pipeline)
  factCheck      FactCheckState @default(PENDING)
  /// Biên tập viên khoa học đã duyệt — hiển thị byline trên trang
  reviewedById   String?
  reviewedBy     User?          @relation("ArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  /// Lần gần nhất đối chiếu lại claim với nguồn. Nội dung khoa học hết hạn:
  /// số liệu được đo lại, bài báo bị rút, đồng thuận thay đổi.
  lastVerifiedAt DateTime?
  /// Hạn đối chiếu lại tiếp theo, do science-editor đặt theo mức độ biến động
  reverifyDueAt  DateTime?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String
  author     User     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags      ArticleTag[]
  comments  Comment[]
  bookmarks Bookmark[]
  revisions Revision[]
  sources   Source[]

  /// Khái niệm mà bài này trình bày. Nguồn của related concepts, prerequisite
  /// và internal link — thay cho cách suy ra từ tag/category.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Nguồn tham khảo — bách khoa toàn thư phải trích dẫn được
model Source {
  id          String    @id @default(cuid())
  articleId   String
  title       String
  url         String?
  publisher   String?
  year        Int?
  /// Bậc nguồn theo phân cấp của science-editor (1 = mạnh nhất).
  /// 1 bình duyệt · 2 cơ quan thẩm quyền · 3 giáo dục · 4 báo chí khoa học.
  /// Bài viết cần tối thiểu 3 nguồn độc lập bậc 1–2.
  tier        Int       @default(2)
  doi         String?
  /// Ngày truy cập URL — nguồn web thay đổi, cần biết đã đọc bản nào
  accessedAt  DateTime?
  /// Khác null nghĩa là bài báo đã bị rút: mọi claim dựa vào nó không còn giá trị
  retractedAt DateTime?
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// Lịch sử phiên bản của bài viết
model Revision {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String   @db.Text
  note      String?
  editorId  String?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String   @db.Text
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  articleId String
  userId    String
  parentId  String?

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([articleId])
  @@index([userId])
}

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

/// Ảnh đã tải lên Supabase Storage.
/// Lưu lại `path` để còn xoá được file khi cần — chỉ có publicUrl thì không đủ,
/// và để biết ảnh nào đang mồ côi (không bài viết nào dùng).
model Media {
  id        String   @id @default(cuid())
  /// Đường dẫn trong bucket, ví dụ "articles/2026/09/abc123.webp"
  path      String   @unique
  bucket    String
  url       String
  mimeType  String
  /// Byte
  size      Int
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById, createdAt])
}

/// Bộ đếm rate limit dùng chung giữa các instance serverless.
/// Xem chú thích trong src/lib/rate-limit.ts để biết vì sao không đếm trong RAM.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

// ---------------------------------------------------------------- AI

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  title     String   @default("Cuộc trò chuyện mới")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String   @db.Text
  /// JSON: danh sách slug bài viết được trích dẫn
  citations String?  @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------------------------------------------------- Knowledge graph
// Xem .claude/agents/knowledge-architect.md và
// .claude/skills/knowledge-graph-manager/SKILL.md.
//
// Category/Tag trả lời "bài này nằm ở đâu". Entity/Relationship trả lời
// "khái niệm này LÀ gì và liên hệ thế nào với khái niệm khác" — đó mới là
// thứ sinh ra internal link có nghĩa, related concepts, và learning path.
// Trước đây related article suy ra từ tag + category, nên chỉ ra được bài
// "cùng chủ đề", không ra được bài "cần đọc trước".

enum EntityType {
  CONCEPT
  PHENOMENON
  ORGANISM
  SUBSTANCE
  OBJECT
  PROCESS
  THEORY
  LAW
  METHOD
  PERSON
  EVENT
  MISSION
  DATASET
  QUANTITY
}

/// Quan hệ có kiểu và có hướng. Cấm quan hệ "related" chung chung:
/// link chỉ có nghĩa khi biết nó nghĩa là gì.
enum RelationType {
  IS_A
  PART_OF
  PREREQUISITE_OF
  CAUSES
  MEASURED_BY
  DISCOVERED_BY
  APPLIES_TO
  CONTRASTS_WITH
  EXAMPLE_OF
}

/// Một khái niệm khoa học — độc lập với ngôn ngữ và độc lập với bài viết.
/// Một entity có tối đa một bài viết mỗi locale; bài viết là cách trình bày
/// entity, không phải bản thân entity.
model Entity {
  id              String     @id @default(cuid())
  slug            String     @unique
  canonicalName   String // tiếng Việt
  canonicalNameEn String
  entityType      EntityType
  /// Tên gọi khác + cách viết sai phổ biến, dùng cho tìm kiếm và khử trùng lặp
  aliases         String[]   @default([])
  /// Định danh Wikidata, ví dụ "Q11982" — để đối chiếu với nguồn thẩm quyền
  wikidataQid     String?
  description     String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles      Article[]
  outgoingEdges Relationship[] @relation("EdgeFrom")
  incomingEdges Relationship[] @relation("EdgeTo")

  @@index([entityType])
  @@index([wikidataQid])
}

model Relationship {
  id           String       @id @default(cuid())
  fromEntityId String
  toEntityId   String
  relType      RelationType
  /// Độ mạnh 0–1, dùng để xếp thứ tự related concepts
  weight       Float        @default(1)
  note         String?

  createdAt DateTime @default(now())

  fromEntity Entity @relation("EdgeFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("EdgeTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  /// Một cặp entity chỉ có một cạnh cho mỗi kiểu quan hệ
  @@unique([fromEntityId, toEntityId, relType])
  @@index([toEntityId, relType])
  @@index([relType])
}
