# Caddy tự xin và tự gia hạn chứng chỉ Let's Encrypt cho {$SITE_DOMAIN}.
# Điều kiện: DNS bản ghi A đã trỏ về IP VPS, và cổng 80/443 mở.

{
	email {$ACME_EMAIL}
	# Bỏ comment dòng dưới khi thử nghiệm để tránh bị Let's Encrypt rate-limit
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Next.js đặt tên file static kèm hash nội dung nên cache vĩnh viễn được
	@immutable path /_next/static/* /icon.svg
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# /api/health để monitor gọi, không cần vào access log
	@health path /api/health
	log_skip @health

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Chuyển www về domain chính để tránh trùng nội dung, ảnh hưởng SEO
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
