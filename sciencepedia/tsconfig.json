{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // "*-DESKTOP-*": bản sao xung đột do OneDrive sinh ra khi hai máy cùng
  // sửa một file. Chúng là bản CŨ, không phải nguồn — để tsc đọc thì một
  // component đã đổi prop sẽ làm typecheck đỏ ở file không ai dùng.
  "exclude": ["node_modules", "**/*-DESKTOP-*"]
}
